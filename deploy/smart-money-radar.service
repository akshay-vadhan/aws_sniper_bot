[Unit]
Description=Solana Smart Money Radar paper bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/aws_sniper_bot/backend
EnvironmentFile=/home/ubuntu/aws_sniper_bot/backend/.env
ExecStart=/home/ubuntu/aws_sniper_bot/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
