DATA_MODE=live
DATABASE_URL=sqlite:///./radar.db

# Helius is preferred. Alchemy is used if Helius is unavailable or unset.
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com
HELIUS_ENHANCED_URL=https://api-mainnet.helius-rpc.com
ALCHEMY_API_KEY=
ALCHEMY_SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2

WALLET_POLL_SECONDS=30
PAPER_BOT_INTERVAL_SECONDS=30
CLUSTER_MIN_WALLETS=3
CLUSTER_WINDOW_MINUTES=10
SMART_MONEY_MIN_SCORE=60

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

CORS_ORIGINS=http://localhost:3000
